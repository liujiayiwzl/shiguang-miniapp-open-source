.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  background: #fbfaf7;
  border-top: 1rpx solid #ece7de;
}

.tab {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab.tab-hover {
  opacity: 0.7;
}

.tab-label {
  font-size: 24rpx;
  line-height: 1;
  color: #a89e92;
}

.tab-label.is-on {
  color: #4f6c60;
  font-weight: 600;
}

.tab-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: transparent;
}

.tab-dot.is-show {
  background: #4f6c60;
}
