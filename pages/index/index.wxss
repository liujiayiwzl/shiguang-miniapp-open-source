page {
  background: #fbfaf7;
  color: #433f38;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page {
  box-sizing: border-box;
  padding: 46rpx 36rpx 60rpx;
}

/* Skyline 页面滚动和底部导航（从 PR #8 合并） */
.page-root {
  height: 100%;
  display: flex;
  flex-direction: column;
}
.page-scroll {
  flex: 1;
  min-height: 0;
}

/* 顶部 */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.brand-row {
  display: flex;
  align-items: baseline;
}

.brand {
  display: block;
  font-size: 52rpx;
  font-weight: 650;
  letter-spacing: 4rpx;
}

.brand-spark {
  display: block;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #b59b7a;
}

.tagline {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #92887c;
}

.header-action {
  flex: none;
  margin-top: 10rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f1efeb;
  color: #617c70;
  font-size: 23rpx;
}

.tap-hover {
  opacity: 0.66;
}

/* 创作区 */
.create-section {
  margin-top: 46rpx;
  padding-top: 38rpx;
  border-top: 1rpx solid #ece7de;
}

.section-title {
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 18rpx;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f2f0ed;
  font-size: 26rpx;
  color: #433f38;
}

.field-placeholder {
  color: #b1aaa1;
  font-size: 24rpx;
}

/* AI 操作 */
.ai-actions {
  display: flex;
  gap: 14rpx;
  margin: 10rpx 0 0;
}

.ai-button {
  flex: 3;
  min-width: 0;
  margin: 0;
  padding: 0;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background-color: #4f6c60;
}

.ai-button-text {
  color: #ffffff;
  font-size: 27rpx;
  line-height: 1;
}

.ai-button.ai-hover {
  background-color: #45604f;
}

.ai-button.is-disabled {
  background-color: #9caca4;
}

.surprise-button {
  flex: 2;
  min-width: 0;
  margin: 0;
  padding: 0;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background-color: #f1efeb;
}

.surprise-text {
  color: #617c70;
  font-size: 24rpx;
  line-height: 1;
}

.surprise-text.is-muted {
  color: #b3aca4;
}

.surprise-button.surprise-hover {
  background-color: #e7e4dd;
}

.surprise-button.is-disabled {
  background-color: #f3f1ee;
}

.ai-button::after,
.surprise-button::after,
.action-button::after {
  border: none;
}

.generate-error {
  margin: 16rpx 0 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #f7ece4;
  color: #a4694d;
  font-size: 23rpx;
  text-align: center;
}

/* 卡片 */
.card {
  box-sizing: border-box;
  min-height: 400rpx;
  padding: 32rpx;
  background: #f2e9db;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 12rpx 36rpx rgba(75, 57, 38, 0.06);
}

.card.is-generating {
  opacity: 0.5;
}

.card-top,
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #9a876e;
}

.card-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 34rpx 14rpx;
}

.card-flower {
  font-size: 50rpx;
  color: #b89b78;
  margin-bottom: 22rpx;
}

.card-text {
  /* 纵向 flex + align-items:center 会让文字按内容撑开，必须限宽才会换行 */
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  font-size: 38rpx;
  line-height: 1.65;
  font-weight: 600;
  text-align: center;
  color: #5a4d3f;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* 越长字号越小，四档保证不会撑出卡面 */
.card-text.is-long {
  font-size: 33rpx;
  line-height: 1.62;
}

.card-text.is-xlong {
  font-size: 29rpx;
  line-height: 1.58;
}

.card-text.is-xxlong {
  font-size: 26rpx;
  line-height: 1.55;
}

.card-skeleton {
  height: 34rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.skeleton-lg {
  width: 68%;
}

.skeleton-md {
  width: 44%;
  height: 26rpx;
}

.card-hint {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a2907a;
  text-align: center;
  word-break: break-word;
}

.card-retry {
  margin-top: 24rpx;
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  color: #8a7458;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.card-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #8a7458;
}

/* 英语表达 */
.card-tools {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 4rpx;
}

.card-tool {
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  color: #617c70;
}

.card-tool-dot {
  margin: 0 6rpx;
  font-size: 24rpx;
  color: #c3bcb2;
}

.english-panel {
  background: #edf2ed;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 18rpx;
}

.english-main {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: #425e51;
}

.english-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #738377;
}

/* 收藏 / 分享 */
.actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background-color: #eeece7;
}

.action-text {
  color: #625b51;
  font-size: 24rpx;
  line-height: 1;
}

.action-text.is-on {
  color: #4f6c60;
  font-weight: 600;
}

.action-text.is-muted {
  color: #a5a09a;
}

.action-button.is-active {
  background-color: #e6ede8;
}

.action-button.is-disabled {
  background-color: #f3f1ee;
}

.action-button.action-hover {
  background-color: #e4e1da;
}

.action-button.is-active.action-hover {
  background-color: #dbe6de;
}

.footnote {
  display: block;
  text-align: center;
  margin-top: 26rpx;
  color: #b1aaa1;
  font-size: 21rpx;
}

/* 普通卡片与 AI 入口区分 */
.mode-hint {
  display: block;
  margin-bottom: 18rpx;
  font-size: 21rpx;
  color: #92887c;
}
.library-actions {
  margin-bottom: 16rpx;
}
.library-button {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #5b786a;
}
.library-button::after { border: none; }
.library-button.surprise-hover { background: #506d5e; }
.library-button.is-disabled { opacity: 0.65; }
.library-button-text {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.library-consent { margin: 8rpx 0 18rpx; color: #82796e; font-size: 20rpx; line-height: 1.6; }
.library-consent checkbox { transform: scale(0.72); transform-origin: left center; }

/* 主题输入框与随机主题按钮：同一行 */
.field {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.field-input {
  flex: 1 1 0%;
  width: 0;
  min-width: 0;
}
.theme-random-button {
  box-sizing: border-box;
  flex: 0 0 76rpx;
  width: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  border-radius: 13rpx;
  background: #e9e6df;
  color: #405b50;
  font-size: 23rpx;
  font-weight: 600;
}
.theme-random-hover { background: #dfdcd4; }

/* 两个等宽、清晰区分的卡片获取方式 */
.create-actions {
  display: flex;
  gap: 14rpx;
  margin: 10rpx 0 16rpx;
}
.create-actions .library-button,
.create-actions .ai-button {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 86rpx;
}
.create-actions .library-button-text,
.create-actions .ai-button-text {
  font-size: 25rpx;
}
