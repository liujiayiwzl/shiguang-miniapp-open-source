page {
  background: #fbfaf7;
  color: #433f38;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* Skyline 没有全局滚动，页面内容都放在 scroll-view 里 */
.page-root {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.page {
  box-sizing: border-box;
  padding: 16rpx 36rpx 60rpx;
}

/* 顶部返回栏 */
.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx 8rpx 6rpx;
  border-radius: 999rpx;
}

.nav-arrow {
  font-size: 40rpx;
  line-height: 40rpx;
  color: #617c70;
  margin-right: 4rpx;
}

.nav-label {
  font-size: 25rpx;
  color: #617c70;
}

.nav-count {
  font-size: 22rpx;
  color: #a89e92;
}

.tap-hover {
  opacity: 0.66;
}

/* 标题区，与首页保持同一套排版 */
.header {
  margin: 16rpx 0 36rpx;
}

.brand {
  display: block;
  font-size: 48rpx;
  font-weight: 650;
  letter-spacing: 4rpx;
}

.tagline {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #92887c;
}

/* 加载骨架 */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  padding: 30rpx;
  background: #f4efe7;
  border-radius: 26rpx;
}

.sk-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: #e7dfd2;
  margin-bottom: 18rpx;
}

.sk-sm {
  width: 28%;
}

.sk-md {
  width: 52%;
  height: 20rpx;
}

.sk-lg {
  width: 82%;
  height: 32rpx;
}

.state-tip {
  display: block;
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b1aaa1;
}

/* 空状态 / 失败状态 */
.state-box {
  margin-top: 60rpx;
  padding: 64rpx 40rpx;
  background: #f6f2ea;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-glyph {
  font-size: 56rpx;
  color: #c0ab8e;
  margin-bottom: 24rpx;
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5a4d3f;
}

.state-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #92887c;
  text-align: center;
}

.state-button {
  margin-top: 36rpx;
  padding: 0 44rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #4f6c60;
  color: #ffffff;
  font-size: 26rpx;
}

.state-button::after {
  border: none;
}

.state-button.button-hover {
  background: #45604f;
}

.state-button-text {
  font-size: 26rpx;
  line-height: 1;
  color: #ffffff;
}

/* 收藏列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.fav-card {
  padding: 28rpx 30rpx;
  background: #f2e9db;
  border-radius: 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(75, 57, 38, 0.05);
}

.fav-card.fav-hover {
  background: #ebe0ce;
}

.fav-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.fav-theme {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #8a7458;
}

.fav-date {
  font-size: 20rpx;
  color: #a2907a;
}

.fav-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.6;
  font-weight: 600;
  color: #5a4d3f;
  word-break: break-word;
}

.fav-text.is-long {
  font-size: 29rpx;
  line-height: 1.55;
}

.fav-text.is-xlong {
  font-size: 26rpx;
  line-height: 1.55;
}

.fav-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.fav-en {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #94836c;
}

.fav-more {
  flex: none;
  margin-left: 16rpx;
  font-size: 21rpx;
  color: #617c70;
}

.footnote {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b1aaa1;
}

/* 卡片详情浮层 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(58, 48, 38, 0.4);
  z-index: 10;
}

.sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 26rpx 36rpx 36rpx;
  background: #fffdf9;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(75, 57, 38, 0.12);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 8rpx;
  background: #e2dbd0;
}

.sheet-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.sheet-theme {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f2e9db;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #8a7458;
}

.sheet-date {
  font-size: 21rpx;
  color: #a2907a;
}

.sheet-text {
  display: block;
  font-size: 36rpx;
  line-height: 1.7;
  font-weight: 600;
  color: #4c4136;
  word-break: break-word;
}

.sheet-en {
  margin-top: 26rpx;
  padding: 22rpx 24rpx;
  background: #edf2ed;
  border-radius: 18rpx;
}

.sheet-en-main {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #425e51;
}

.sheet-en-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #738377;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 34rpx;
}

.sheet-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
}

.sheet-button::after {
  border: none;
}

.sheet-button.ghost {
  background: #f1efeb;
  color: #625b51;
}

.sheet-button.danger {
  background: #f7e7e0;
  color: #a4694d;
}

.sheet-button.is-disabled {
  background: #f3f1ee;
  color: #b3aca4;
}

.sheet-button.ghost.button-hover {
  background: #e8e5df;
}

.sheet-button.danger.button-hover {
  background: #f0d8ce;
}

.sheet-button-text {
  font-size: 27rpx;
  line-height: 1;
  color: #625b51;
}

.sheet-button-text.is-danger {
  color: #a4694d;
}

.sheet-button-text.is-muted {
  color: #b3aca4;
}
